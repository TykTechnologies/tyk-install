# =============================================================================
# TYK OSS ON KUBERNETES - NO LICENCE REQUIRED
# =============================================================================
# The open source Gateway needs no licence. These values are for the install
# commands in README.md; the chart itself is configured through values.yaml.
# =============================================================================

NAMESPACE=tyk
RELEASE_NAME=tyk-oss

# Chart versions this configuration was tested against
TYK_OSS_CHART_VERSION=5.4.0
REDIS_CHART_VERSION=19.0.2

# SECURITY: Replace CHANGEME in values.yaml, or supply it as a Kubernetes secret
# and set global.secrets.useSecretName. This is the Gateway API credential.
# API_SECRET=
