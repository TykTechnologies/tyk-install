# =============================================================================
# TYK MDCB ON KUBERNETES
# =============================================================================
# Values for the install commands in README.md. The charts themselves are
# configured through values-control-plane.yaml and values-data-plane.yaml.
#
# SECURITY: Do not put licence values in this file. Create a Kubernetes secret
# and reference it with global.secrets.useSecretName - README.md shows how.
# =============================================================================

CONTROL_PLANE_NAMESPACE=tyk
DATA_PLANE_NAMESPACE=tyk-dp
CONTROL_PLANE_RELEASE=tyk-cp
DATA_PLANE_RELEASE=tyk-dp

# Chart versions this configuration was tested against
TYK_CONTROL_PLANE_CHART_VERSION=5.3.0
TYK_DATA_PLANE_CHART_VERSION=5.3.0
REDIS_CHART_VERSION=19.0.2
POSTGRESQL_CHART_VERSION=12.12.10

# Licence variables, read from your environment when creating the secret.
# Never commit their values.
TYK_LICENSE_KEY=
TYK_MDCB_LICENSE=

# The MDCB address each data plane connects to, from step 2 of README.md.
# MDCB speaks gRPC on 9091.
MDCB_CONNECTION_STRING=
