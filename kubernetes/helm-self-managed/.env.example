# LICENSE (REQUIRED)
TYK_LICENSE_KEY=
# OPERATOR LICENSE
TYK_OPERATOR_LICENSE=
# DEV PORTAL LICENSE
TYK_PORTAL_LICENSE=

# SECRETS
TYK_API_SECRET=352d20ee67be67f6340b4c0605b044b7 # SECURITY: node_secret. Committed development default - replace with `openssl rand -hex 32`
TYK_ADMIN_SECRET=admin-secret # SECURITY: admin_secret grants full Dashboard admin access. Committed development default - replace it
POSTGRES_USER=tykuser
POSTGRES_PASSWORD=tykSecurePass123 # SECURITY: Committed development default - replace, and prefer a Kubernetes secret over this file
POSTGRES_DB=tyk_analytics 
# additional psq db created via init script for dev portal
DevPortalDatabaseConnectionString="host=tyk-postgres-postgresql port=5432 dbname=portal user=tykuser password=tykSecurePass123 sslmode=disable" # SECURITY: password inline and sslmode=disable. PROD: use sslmode=require and a secret
DashDatabaseConnectionString="host=tyk-postgres-postgresql port=5432 dbname=tyk_analytics user=tykuser password=tykSecurePass123 sslmode=disable" # SECURITY: password inline and sslmode=disable. PROD: use sslmode=require and a secret
# ADMIN USER
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_EMAIL=default@example.com # don't change for bootstrap
ADMIN_PASSWORD=topsecret123 # SECURITY: initial Dashboard admin password. Committed development default - change before any shared deployment
