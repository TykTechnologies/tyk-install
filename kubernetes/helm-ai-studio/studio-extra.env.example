# Extra AI Studio settings the chart cannot set through values.
# Loaded into ConfigMap tyk-ai-studio-extra and applied by post-render.sh.
# Keep secrets (CSRF_KEY, METRICS_AUTH_TOKEN) in the Secret
# tyk-ai-studio-extra instead (see README).

# -----------------------------------------------------------------------------
# Production settings (reference architecture)
# -----------------------------------------------------------------------------
# Origins allowed to call the OAuth, metadata and plugin UI endpoints
CORS_ALLOWED_ORIGINS=https://studio.example.com
# Refuse plugin commands that target loopback or private addresses
PLUGIN_BLOCK_INTERNAL_URLS=true
# gRPC control connection over TLS (needs Secret tyk-ai-studio-grpc-tls and
# config.grpcTlsInsecure=false, see values-production.yaml)
GRPC_TLS_CERT_PATH=/opt/tyk-ai-studio/certs/grpc/tls.crt
GRPC_TLS_KEY_PATH=/opt/tyk-ai-studio/certs/grpc/tls.key
