# AI Studio chart version (git tag of TykTechnologies/ai-studio)
AI_STUDIO_VERSION=v2.3.0-rc6

# ENTERPRISE LICENSE (Enterprise images only). AI Studio 2.3 needs a license
# issued for 2.3: a 2.2 license is refused.
TYK_AI_LICENSE=

# SECRETS - generate each with: openssl rand -hex 16
# Never change TYK_AI_SECRET_KEY after the first start: App keys stop validating.
TYK_AI_SECRET_KEY=
# Shared by AI Studio and the Edge Gateway
MICROGATEWAY_ENCRYPTION_KEY=
# Shared by AI Studio and the Edge Gateway
GRPC_AUTH_TOKEN=

# INTERNAL POSTGRESQL - use hex: the chart does not escape it in the connection URL
POSTGRES_PASSWORD=
