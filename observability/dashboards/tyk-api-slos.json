{
  "title": "Tyk Gateway - API SLOs",
  "uid": "tyk-api-slos",
  "description": "Availability, error budget and upstream response time per API, from the Gateway's OTLP metrics.",
  "tags": [
    "tyk",
    "gateway",
    "slo"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "datasource_prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "service_name",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource_prometheus}"
        },
        "query": {
          "query": "label_values(tyk_gateway_apis_loaded, service_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(tyk_gateway_apis_loaded, service_name)",
        "current": {
          "text": "tyk-gateway",
          "value": "tyk-gateway"
        },
        "description": "The Gateway's OpenTelemetry resource name (TYK_GW_OPENTELEMETRY_RESOURCENAME, default tyk-gateway).",
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "hide": 0,
        "sort": 1
      },
      {
        "name": "api_name",
        "label": "API",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource_prometheus}"
        },
        "query": {
          "query": "label_values(tyk_requests_by_path_total{service_name=~\"$service_name\"}, api_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(tyk_requests_by_path_total{service_name=~\"$service_name\"}, api_name)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "api_id",
        "label": "API id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource_prometheus}"
        },
        "query": {
          "query": "label_values(tyk_requests_by_path_total{service_name=~\"$service_name\", api_name=~\"$api_name\"}, api_id)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(tyk_requests_by_path_total{service_name=~\"$service_name\", api_name=~\"$api_name\"}, api_id)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 2
      },
      {
        "name": "slo_availability_target",
        "label": "Availability SLO (%)",
        "type": "custom",
        "query": "99,99.5,99.9,99.95,99.99",
        "current": {
          "text": "99.9",
          "value": "99.9"
        },
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "options": [
          {
            "text": "99",
            "value": "99",
            "selected": false
          },
          {
            "text": "99.5",
            "value": "99.5",
            "selected": false
          },
          {
            "text": "99.9",
            "value": "99.9",
            "selected": true
          },
          {
            "text": "99.95",
            "value": "99.95",
            "selected": false
          },
          {
            "text": "99.99",
            "value": "99.99",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "API Portfolio",
      "type": "link",
      "url": "/d/tyk-api-portfolio",
      "keepTime": true,
      "includeVars": false,
      "icon": "dashboard"
    },
    {
      "title": "API Troubleshooting",
      "type": "link",
      "url": "/d/tyk-api-troubleshooting",
      "keepTime": true,
      "includeVars": false,
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Error budget remaining",
      "description": "Share of the error budget left over the last 30 days, for the availability SLO selected above. Errors are 5xx responses (tyk_requests_by_path_total).",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "expr": "(1 - (sum by (api_name) (rate(tyk_requests_by_path_total{service_name=~\"$service_name\", api_name=~\"$api_name\", response_code=~\"5..\"}[30d])) or sum by (api_name) (rate(tyk_requests_by_path_total{service_name=~\"$service_name\", api_name=~\"$api_name\"}[30d])) * 0) / (sum by (api_name) (rate(tyk_requests_by_path_total{service_name=~\"$service_name\", api_name=~\"$api_name\"}[30d])) > 0) / (1 - $slo_availability_target / 100)) * 100",
          "legendFormat": "{{api_name}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 25
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "status-history",
      "title": "Availability (10m window)",
      "description": "Share of non-5xx responses per API over a rolling 10 minutes, against the availability SLO.",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "expr": "(1 - (sum by (api_name) (rate(tyk_requests_by_path_total{service_name=~\"$service_name\", api_name=~\"$api_name\", response_code=~\"5..\"}[10m])) or sum by (api_name) (rate(tyk_requests_by_path_total{service_name=~\"$service_name\", api_name=~\"$api_name\"}[10m])) * 0) / (sum by (api_name) (rate(tyk_requests_by_path_total{service_name=~\"$service_name\", api_name=~\"$api_name\"}[10m])) > 0)) * 100",
          "legendFormat": "{{api_name}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.9,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Errors",
      "description": "5xx responses per second, and their share of all requests.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "expr": "sum(rate(tyk_requests_by_path_total{service_name=~\"$service_name\", api_name=~\"$api_name\", response_code=~\"5..\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "5xx / s",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "expr": "(sum(rate(tyk_requests_by_path_total{service_name=~\"$service_name\", api_name=~\"$api_name\", response_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(tyk_requests_by_path_total{service_name=~\"$service_name\", api_name=~\"$api_name\"}[$__rate_interval])) * 100",
          "legendFormat": "Error ratio %",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "5xx / s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error ratio %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Upstream response time",
      "description": "90th, 95th and 99th percentile of the upstream's response time (tyk_upstream_request_duration_seconds), excluding the Gateway's own processing.",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "expr": "histogram_quantile(0.90, sum by (le) (rate(tyk_upstream_request_duration_seconds_bucket{service_name=~\"$service_name\", tyk_api_id=~\"$api_id\"}[$__rate_interval])))",
          "legendFormat": "p90",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tyk_upstream_request_duration_seconds_bucket{service_name=~\"$service_name\", tyk_api_id=~\"$api_id\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tyk_upstream_request_duration_seconds_bucket{service_name=~\"$service_name\", tyk_api_id=~\"$api_id\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "Status codes",
      "description": "Responses by HTTP status code.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "expr": "sum by (response_code) (rate(tyk_requests_by_path_total{service_name=~\"$service_name\", api_name=~\"$api_name\"}[$__rate_interval]))",
          "legendFormat": "{{response_code}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value"
          ]
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests per endpoint",
      "description": "Request rate by matched endpoint.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "expr": "sum by (endpoint) (rate(tyk_requests_by_path_total{service_name=~\"$service_name\", api_name=~\"$api_name\"}[$__rate_interval]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests per method",
      "description": "Request rate by HTTP method.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_prometheus}"
          },
          "expr": "sum by (method) (rate(tyk_requests_by_path_total{service_name=~\"$service_name\", api_name=~\"$api_name\"}[$__rate_interval]))",
          "legendFormat": "{{method}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
