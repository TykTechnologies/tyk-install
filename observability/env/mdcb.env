### =============================================================================
### TYK MDCB - OPENTELEMETRY METRICS
### =============================================================================
### Needs Tyk MDCB 2.14+ (older versions ignore these settings and the MDCB dashboard stays empty).
### tyk-install has no MDCB deployment: add these to your MDCB's environment, or create the
### tyk-otel-mdcb ConfigMap from this file on Kubernetes (see kubernetes/observability).
### Comments sit on their own lines: kubectl --from-env-file keeps anything after "=" as the value.
### =============================================================================

# Use the Dashboard's TYK_DB_CONTROLPLANEID so both show up as one control plane
TYK_MDCB_CONTROLPLANEID=tyk-control-plane
TYK_MDCB_OPENTELEMETRY_METRICS_ENABLED=true
# Collector address (gRPC). PROD: set TYK_MDCB_OPENTELEMETRY_METRICS_TLS_* when the collector is remote
TYK_MDCB_OPENTELEMETRY_METRICS_ENDPOINT=otel-collector:4317
TYK_MDCB_OPENTELEMETRY_METRICS_EXPORTER=grpc
# Seconds between exports. PROD: 60 (the default) unless dashboards need fresher data
TYK_MDCB_OPENTELEMETRY_METRICS_EXPORTINTERVAL=15
# deployment_environment label. PROD: production, staging, ...
TYK_MDCB_OPENTELEMETRY_METRICS_DEPLOYMENTENVIRONMENT=development
#
# Metric families, all on by default; set one to false to drop it
# TYK_MDCB_OPENTELEMETRY_METRICS_DATAPLANESMETRICS=true
# TYK_MDCB_OPENTELEMETRY_METRICS_RPCMETRICS=true
# TYK_MDCB_OPENTELEMETRY_METRICS_SYNCMETRICS=true
# TYK_MDCB_OPENTELEMETRY_METRICS_ANALYTICSMETRICS=true
# TYK_MDCB_OPENTELEMETRY_METRICS_HEALTHMETRICS=true
# TYK_MDCB_OPENTELEMETRY_METRICS_DEPENDENCYMETRICS=true
# TYK_MDCB_OPENTELEMETRY_METRICS_EXPIRYMETRICS=true
# TYK_MDCB_OPENTELEMETRY_METRICS_METAMETRICS=true
# TYK_MDCB_OPENTELEMETRY_METRICS_RUNTIMEMETRICS=true
