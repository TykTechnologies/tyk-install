### =============================================================================
### TYK DEVELOPER PORTAL - OPENTELEMETRY METRICS
### =============================================================================
### Needs Tyk Developer Portal 1.20+ (older versions ignore these settings and the Portal dashboard stays empty).
### Docker: loaded after confs/portal.env by docker-compose.otel.yml.
### Kubernetes: becomes the tyk-otel-portal ConfigMap (see kubernetes/observability).
### Comments sit on their own lines: kubectl --from-env-file keeps anything after "=" as the value.
### =============================================================================

PORTAL_OPENTELEMETRY_METRICS_ENABLED=true
# Collector address (gRPC). PROD: set PORTAL_OPENTELEMETRY_METRICS_TLS_* when the collector is remote
PORTAL_OPENTELEMETRY_METRICS_ENDPOINT=otel-collector:4317
PORTAL_OPENTELEMETRY_METRICS_EXPORTER=grpc
# Seconds between exports. PROD: 60 (the default) unless dashboards need fresher data
PORTAL_OPENTELEMETRY_METRICS_EXPORTINTERVAL=15
# deployment_environment label. PROD: production, staging, ...
PORTAL_OPENTELEMETRY_METRICS_DEPLOYMENTENVIRONMENT=development
# The Portal has no control plane id setting: pass it as a resource attribute. Use the Dashboard's TYK_DB_CONTROLPLANEID
OTEL_RESOURCE_ATTRIBUTES=control_plane_id=tyk-control-plane
#
# Metric families, all on by default; set one to false to drop it
# PORTAL_OPENTELEMETRY_METRICS_PROVIDERMETRICS=true
# PORTAL_OPENTELEMETRY_METRICS_HEALTHMETRICS=true
