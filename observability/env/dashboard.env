### =============================================================================
### TYK DASHBOARD - OPENTELEMETRY METRICS
### =============================================================================
### Needs Tyk Dashboard 5.16+ (older versions ignore these settings and the control plane dashboards stay empty).
### Docker: loaded after confs/tyk_analytics.env by docker-compose.otel.yml.
### Kubernetes: becomes the tyk-otel-dashboard ConfigMap (see kubernetes/observability).
### Comments sit on their own lines: kubectl --from-env-file keeps anything after "=" as the value.
### =============================================================================

# Stamped on every series as control_plane_id; the Environments Overview groups by it. PROD: one value per control plane
TYK_DB_CONTROLPLANEID=tyk-control-plane
TYK_DB_OPENTELEMETRY_METRICS_ENABLED=true
# Collector address (gRPC). PROD: set TYK_DB_OPENTELEMETRY_METRICS_TLS_* when the collector is remote
TYK_DB_OPENTELEMETRY_METRICS_ENDPOINT=otel-collector:4317
TYK_DB_OPENTELEMETRY_METRICS_EXPORTER=grpc
# Seconds between exports. PROD: 60 (the default) unless dashboards need fresher data
TYK_DB_OPENTELEMETRY_METRICS_EXPORTINTERVAL=15
# deployment_environment label. PROD: production, staging, ...
TYK_DB_OPENTELEMETRY_METRICS_DEPLOYMENTENVIRONMENT=development
# How often APIs, policies and users are counted, in seconds (min 10). PERFORMANCE: raise it on large estates
TYK_DB_OPENTELEMETRY_METRICS_OBJECTSMETRICS_COLLECTIONINTERVAL=60
# Count only these organisations (comma separated); all of them by default
# TYK_DB_OPENTELEMETRY_METRICS_OBJECTSMETRICS_ORGIDS=
# API governance compliance counts (needs a governance licence)
# TYK_DB_OPENTELEMETRY_METRICS_OBJECTSMETRICS_GOVERNANCE=true
#
# Metric families, all on by default; set one to false to drop it
# TYK_DB_OPENTELEMETRY_METRICS_HTTPMETRICS=true
# TYK_DB_OPENTELEMETRY_METRICS_GATEWAYMETRICS=true
# TYK_DB_OPENTELEMETRY_METRICS_HEALTHMETRICS=true
# TYK_DB_OPENTELEMETRY_METRICS_DEPENDENCYMETRICS=true
# TYK_DB_OPENTELEMETRY_METRICS_LICENSEMETRICS=true
# TYK_DB_OPENTELEMETRY_METRICS_CERTIFICATEMETRICS=true
# TYK_DB_OPENTELEMETRY_METRICS_NOTIFICATIONMETRICS=true
# TYK_DB_OPENTELEMETRY_METRICS_METAMETRICS=true
# TYK_DB_OPENTELEMETRY_METRICS_RUNTIMEMETRICS=true
# TYK_DB_OPENTELEMETRY_METRICS_OBJECTSMETRICS_ENABLED=true
