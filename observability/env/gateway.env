### =============================================================================
### TYK GATEWAY - OPENTELEMETRY (traces, metrics and logs)
### =============================================================================
### Needs Tyk Gateway 5.13+. Defaults suit development; comments describe PRODUCTION or PERFORMANCE tuning.
### Docker: loaded after confs/tyk.env by docker-compose.otel.yml, so these values win.
### Kubernetes: becomes the tyk-otel-gateway ConfigMap (see kubernetes/observability).
### Comments sit on their own lines: kubectl --from-env-file keeps anything after "=" as the value.
### =============================================================================

### -----------------------------------------------------------------------------
### TRACES
### -----------------------------------------------------------------------------
TYK_GW_OPENTELEMETRY_TRACES_ENABLED=true
# Collector address (gRPC). PROD: set TYK_GW_OPENTELEMETRY_TRACES_TLS_* when the collector is remote
TYK_GW_OPENTELEMETRY_TRACES_ENDPOINT=otel-collector:4317
TYK_GW_OPENTELEMETRY_TRACES_EXPORTER=grpc
# Every request is traced. PROD/PERFORMANCE: TraceIDRatioBased with a rate of 0.01-0.1
TYK_GW_OPENTELEMETRY_TRACES_SAMPLING_TYPE=AlwaysOn
# TYK_GW_OPENTELEMETRY_TRACES_SAMPLING_RATE=0.1
# Follow the caller's sampling decision when it sends a traceparent header
# TYK_GW_OPENTELEMETRY_TRACES_SAMPLING_PARENTBASED=true

### -----------------------------------------------------------------------------
### METRICS
### -----------------------------------------------------------------------------
TYK_GW_OPENTELEMETRY_METRICS_ENABLED=true
TYK_GW_OPENTELEMETRY_METRICS_ENDPOINT=otel-collector:4317
TYK_GW_OPENTELEMETRY_METRICS_EXPORTER=grpc
# Seconds between exports. PROD: 60 (the default) unless dashboards need fresher data
TYK_GW_OPENTELEMETRY_METRICS_EXPORTINTERVAL=15
# Go runtime metrics (goroutines, heap, GC) for the Fleet Health dashboard
TYK_GW_OPENTELEMETRY_METRICS_RUNTIMEMETRICS=true
# Max label combinations per metric before new ones are dropped (default 2000)
# TYK_GW_OPENTELEMETRY_METRICS_CARDINALITYLIMIT=2000
#
# API metric definitions: 22 instruments that populate every Gateway dashboard panel.
# Each one is {"name","type","description","histogram_source","dimensions":[{"source","key","label","default"}],"filters"}.
# Sources: metadata (request fields), session (auth session), header / response_header, context (set by middleware).
# PERFORMANCE: these labels grow with your traffic, remove the instruments or dimensions you do not need:
#   Mcp-Session-Id on http.server.request.duration (one histogram per MCP session)
#   tyk.requests.by.apikey (per key), tyk.requests.by.oauth (per OAuth client), tyk.requests.by.portal (per portal app)
#   tyk.requests.by.tenant / tyk.latency.by.tenant / tyk.requests.by.customer (per X-Tenant-ID / X-Customer-ID header value)
#   tyk.requests.by.path (per endpoint and host)
# Unset the variable to get the Gateway's 4 built-in RED instruments instead; dashboards then lose the identity, tenant and cache rows.
TYK_GW_OPENTELEMETRY_METRICS_APIMETRICS=[{"name":"http.server.request.duration","type":"histogram","description":"End-to-end request latency","histogram_source":"total","dimensions":[{"source":"metadata","key":"method","label":"http.request.method"},{"source":"metadata","key":"response_code","label":"http.response.status_code"},{"source":"metadata","key":"api_id","label":"tyk.api.id"},{"source":"metadata","key":"response_flag","label":"tyk.response_flag"},{"source":"metadata","key":"mcp_method","label":"mcp.method.name"},{"source":"header","key":"Mcp-Session-Id","label":"mcp.session.id","default":""}]},{"name":"tyk.gateway.request.duration","type":"histogram","description":"Gateway processing time","histogram_source":"gateway","dimensions":[{"source":"metadata","key":"method","label":"http.request.method"},{"source":"metadata","key":"api_id","label":"tyk.api.id"},{"source":"metadata","key":"response_flag","label":"tyk.response_flag"}]},{"name":"tyk.upstream.request.duration","type":"histogram","description":"Upstream response time","histogram_source":"upstream","dimensions":[{"source":"metadata","key":"method","label":"http.request.method"},{"source":"metadata","key":"api_id","label":"tyk.api.id"},{"source":"metadata","key":"response_flag","label":"tyk.response_flag"}]},{"name":"tyk.api.requests.total","type":"counter","description":"Request count with identity dimensions","dimensions":[{"source":"metadata","key":"method","label":"http.request.method"},{"source":"metadata","key":"response_code","label":"http.response.status_code"},{"source":"metadata","key":"api_id","label":"tyk.api.id"}]},{"name":"tyk.requests.by.path","type":"counter","description":"Request count by path and API name (metadata)","dimensions":[{"source":"metadata","key":"listen_path","label":"listen_path"},{"source":"metadata","key":"endpoint","label":"endpoint"},{"source":"metadata","key":"api_id","label":"api_id"},{"source":"metadata","key":"api_name","label":"api_name"},{"source":"metadata","key":"method","label":"method"},{"source":"metadata","key":"response_code","label":"response_code"},{"source":"metadata","key":"scheme","label":"scheme","default":"http"},{"source":"metadata","key":"host","label":"host"}]},{"name":"tyk.requests.by.org","type":"counter","description":"Request count per organization (metadata)","dimensions":[{"source":"metadata","key":"org_id","label":"org_id"},{"source":"metadata","key":"api_id","label":"api_id"},{"source":"metadata","key":"api_name","label":"api_name"},{"source":"metadata","key":"method","label":"method"}]},{"name":"tyk.requests.by.version","type":"counter","description":"Request count per API version (metadata)","dimensions":[{"source":"metadata","key":"api_version","label":"api_version"},{"source":"metadata","key":"api_id","label":"api_id"},{"source":"metadata","key":"response_code","label":"response_code"}]},{"name":"tyk.requests.by.apikey","type":"counter","description":"Request count per API key suffix - last 6 chars (session)","dimensions":[{"source":"session","key":"api_key","label":"api_key_suffix"},{"source":"metadata","key":"api_id","label":"api_id"}]},{"name":"tyk.requests.by.oauth","type":"counter","description":"Request count per OAuth client ID (session)","dimensions":[{"source":"session","key":"oauth_id","label":"oauth_client_id"},{"source":"metadata","key":"api_id","label":"api_id"},{"source":"metadata","key":"response_code","label":"response_code"}]},{"name":"tyk.requests.by.portal","type":"counter","description":"Request count per developer portal app and org (session)","dimensions":[{"source":"session","key":"portal_app","label":"portal_app"},{"source":"session","key":"portal_org","label":"portal_org"},{"source":"metadata","key":"api_id","label":"api_id"}]},{"name":"tyk.requests.by.tenant","type":"counter","description":"Request count per tenant from X-Tenant-ID request header","dimensions":[{"source":"header","key":"X-Tenant-ID","label":"tenant_id","default":"unknown"},{"source":"metadata","key":"api_id","label":"api_id"},{"source":"metadata","key":"response_code","label":"response_code"}]},{"name":"tyk.latency.by.tenant","type":"histogram","description":"End-to-end latency per tenant from X-Tenant-ID request header","histogram_source":"total","dimensions":[{"source":"header","key":"X-Tenant-ID","label":"tenant_id","default":"unknown"},{"source":"metadata","key":"api_id","label":"api_id"}]},{"name":"tyk.requests.by.customer","type":"counter","description":"Request count per customer from X-Customer-ID request header","dimensions":[{"source":"header","key":"X-Customer-ID","label":"customer_id","default":"unknown"},{"source":"header","key":"X-Tenant-ID","label":"tenant_id","default":"unknown"}]},{"name":"tyk.requests.with.cache","type":"counter","description":"Request count by cache status from X-Tyk-Cached-Response response header","dimensions":[{"source":"response_header","key":"X-Tyk-Cached-Response","label":"cache_status","default":"0"},{"source":"metadata","key":"api_id","label":"api_id"}]},{"name":"tyk.requests.by.backend.version","type":"counter","description":"Request count by backend version from X-Backend-Version response header","dimensions":[{"source":"response_header","key":"X-Backend-Version","label":"backend_version","default":"unknown"},{"source":"metadata","key":"api_id","label":"api_id"}]},{"name":"tyk.requests.by.content.type","type":"counter","description":"Request count by Content-Type response header","dimensions":[{"source":"response_header","key":"Content-Type","label":"content_type","default":"unknown"},{"source":"metadata","key":"api_id","label":"api_id"}]},{"name":"tyk.requests.by.tier","type":"counter","description":"Request count per subscription tier from context variable","dimensions":[{"source":"context","key":"subscription_tier","label":"subscription_tier","default":"standard"},{"source":"metadata","key":"api_id","label":"api_id"},{"source":"metadata","key":"response_code","label":"response_code"}]},{"name":"tyk.latency.by.tier","type":"histogram","description":"End-to-end latency per subscription tier from context variable","histogram_source":"total","dimensions":[{"source":"context","key":"subscription_tier","label":"subscription_tier","default":"standard"},{"source":"metadata","key":"api_id","label":"api_id"}]},{"name":"tyk.requests.by.region","type":"counter","description":"Request count per region from context variable","dimensions":[{"source":"context","key":"region","label":"region","default":"unknown"},{"source":"metadata","key":"api_id","label":"api_id"}]},{"name":"tyk.errors.by.flag","type":"counter","description":"Error count by response flag, status code and API - pre-filtered to 4xx/5xx at instrument level","dimensions":[{"source":"metadata","key":"response_flag","label":"tyk.response_flag"},{"source":"metadata","key":"response_code","label":"http.response.status_code"},{"source":"metadata","key":"api_id","label":"tyk.api.id"},{"source":"metadata","key":"api_name","label":"tyk.api.name"},{"source":"metadata","key":"method","label":"http.request.method"}],"filters":{"status_codes":["4xx","5xx"]}},{"name":"tyk.mcp.requests.total","type":"counter","description":"MCP requests by method and primitive","dimensions":[{"source":"metadata","key":"mcp_method","label":"mcp.method.name"},{"source":"metadata","key":"mcp_primitive_type","label":"mcp.primitive.type"},{"source":"metadata","key":"mcp_primitive_name","label":"mcp.primitive.name"},{"source":"metadata","key":"mcp_error_code","label":"mcp.error.code"},{"source":"metadata","key":"response_code","label":"http.response.status_code"},{"source":"metadata","key":"api_id","label":"tyk.api.id"},{"source":"metadata","key":"api_name","label":"tyk.api.name"}]},{"name":"tyk.mcp.primitive.duration","type":"histogram","description":"MCP primitive execution duration","histogram_source":"upstream","dimensions":[{"source":"metadata","key":"mcp_primitive_type","label":"mcp.primitive.type"},{"source":"metadata","key":"mcp_primitive_name","label":"mcp.primitive.name"},{"source":"metadata","key":"api_id","label":"tyk.api.id"}]}]

### -----------------------------------------------------------------------------
### LOGS
### Collected from the container's stdout by the OpenTelemetry Collector (filelog), not exported by the Gateway.
### -----------------------------------------------------------------------------
# JSON lines, so the collector can extract level, API id and trace id
TYK_GW_LOGFORMAT=json
# One line per request with its trace id, for the troubleshooting dashboard. PERFORMANCE: doubles log volume under load
TYK_GW_ACCESSLOGS_ENABLED=true
