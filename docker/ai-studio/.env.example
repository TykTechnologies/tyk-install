# Images: Community Edition by default.
# Enterprise: tykio/tyk-ai-studio-ent and tykio/tyk-microgateway-ent
AI_STUDIO_IMAGE=tykio/tyk-ai-studio
MICROGATEWAY_IMAGE=tykio/tyk-microgateway

# Component versions (AI Studio and Edge Gateway must run the same version)
AI_STUDIO_VERSION=v2.2.2
MICROGATEWAY_VERSION=v2.2.2

# Enterprise license (Enterprise images only, set before the first start)
TYK_AI_LICENSE=

# Required by docker-compose.production.yml (generate with: openssl rand -hex 16)
METRICS_AUTH_TOKEN=
