# =============================================================================
# Core Settings
# =============================================================================
# DEVMODE=true is only needed for login over plain HTTP. This bundle serves HTTPS.
DEVMODE=false
ALLOW_REGISTRATIONS=true
SITE_URL=https://ai-studio.localhost:4000
FROM_EMAIL=noreply@example.com
CERT_FILE=/opt/tyk-ai-studio/certs/tls-certificate.pem
KEY_FILE=/opt/tyk-ai-studio/certs/tls-private-key.pem

# =============================================================================
# Database
# =============================================================================
DATABASE_TYPE=postgres
DATABASE_URL=postgresql://tykuser:tykSecurePass123@postgres:5432/tyk_ai_studio?sslmode=disable

# =============================================================================
# Security - REPLACE THESE (generate each with: openssl rand -hex 16)
# AI Studio refuses to start while a __REPLACE_WITH_ placeholder is left in
# TYK_AI_SECRET_KEY, MICROGATEWAY_ENCRYPTION_KEY or GRPC_AUTH_TOKEN.
# =============================================================================
# Encrypts LLM credentials, App keys and the secret store, and is needed for SSO.
# Never change it after the first start: App keys stop validating.
TYK_AI_SECRET_KEY=__REPLACE_WITH_RANDOM_SECRET_KEY__
MICROGATEWAY_ENCRYPTION_KEY=__REPLACE_WITH_RANDOM_32_CHAR_KEY__
# Keeps CSRF tokens valid across restarts (random per process when unset)
CSRF_KEY=__REPLACE_WITH_RANDOM_CSRF_KEY__

# =============================================================================
# Hub-Spoke: Control Plane Mode
# =============================================================================
GATEWAY_MODE=control
GRPC_PORT=50051
GRPC_HOST=0.0.0.0
GRPC_TLS_INSECURE=true
GRPC_AUTH_TOKEN=__REPLACE_WITH_RANDOM_TOKEN__

# =============================================================================
# Proxy - Point to external Edge Gateway URL
# =============================================================================
PROXY_URL=http://localhost:9091
TOOL_DISPLAY_URL=http://localhost:9091
DATASOURCE_DISPLAY_URL=http://localhost:9091

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info
DEBUG_HTTP=false
DEBUG_HTTP_PROXY=false

# =============================================================================
# Plugins
# =============================================================================
# ./plugins is mounted at /opt/plugins, which is in the default allowed
# plugin directories. Extend with AI_STUDIO_PLUGIN_ALLOWED_DIRS if needed.
PLUGIN_COMMAND_ALLOWLIST=/opt/plugins

# =============================================================================
# Plugin Marketplace (Optional - enables browsing and installing plugins)
# =============================================================================
# AI_STUDIO_OCI_CACHE_DIR must be set to enable the marketplace.
# Without it, the Marketplace page will be empty.
MARKETPLACE_ENABLED=true
MARKETPLACE_INDEX_URL=https://raw.githubusercontent.com/TykTechnologies/tyk-ai-studio-plugins-ce/main/index.yaml
MARKETPLACE_SYNC_INTERVAL=1h
MARKETPLACE_CACHE_DIR=./data/cache/marketplace
AI_STUDIO_OCI_CACHE_DIR=./data/cache/plugins
# Enterprise verifies OCI plugin signatures and refuses unsigned plugins.
# Community Edition cannot verify them: it logs a warning and loads them unverified.
AI_STUDIO_OCI_REQUIRE_SIGNATURE=true

# =============================================================================
# Outbound network policy
# =============================================================================
# Calls to internal addresses (LLMs, embedders, tools, data sources, guardrail
# providers) are refused unless the host is allowed. These are the optional
# services from docker-compose.rag.yml and docker-compose.presidio.yml. Add your
# own in-network hosts here, for example a local Ollama (host.docker.internal).
LLM_UPSTREAM_BLOCK_INTERNAL=true
LLM_UPSTREAM_ALLOWED_INTERNAL_HOSTS=transformer-server,reranker,presidio-analyzer,presidio-anonymizer

# =============================================================================
# Credentials
# =============================================================================
# $ENV/NAME references in LLMs, tools, data sources, embedders and guardrails
# resolve only for the variable names listed here (comma-separated). Prefer the
# secret store ($SECRET/NAME references).
# AI_STUDIO_ENV_REF_ALLOWLIST=

# =============================================================================
# Metrics (Optional - /metrics is not served unless one of these is set)
# =============================================================================
# METRICS_AUTH_TOKEN=change-me-metrics-token
# METRICS_ALLOW_UNAUTHENTICATED=true

# =============================================================================
# Enterprise Edition
# =============================================================================
# TYK_AI_LICENSE is passed in from .env by docker-compose.yml

# =============================================================================
# SMTP (Optional - required for email invites/notifications)
# =============================================================================
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-password
