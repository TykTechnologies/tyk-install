# =============================================================================
# Core Settings
# =============================================================================
# DEVMODE=true is only needed for login over plain HTTP. This bundle serves HTTPS.
DEVMODE=false
ALLOW_REGISTRATIONS=true
SITE_URL=https://ai-studio.localhost:4000
FROM_EMAIL=noreply@example.com
CERT_FILE=/opt/tyk-ai-studio/certs/tls-certificate.pem
KEY_FILE=/opt/tyk-ai-studio/certs/tls-private-key.pem

# =============================================================================
# Database
# =============================================================================
DATABASE_TYPE=postgres
DATABASE_URL=postgresql://tykuser:tykSecurePass123@postgres:5432/tyk_ai_studio?sslmode=disable

# =============================================================================
# Security - CHANGE THESE (generate each with: openssl rand -hex 16)
# =============================================================================
TYK_AI_SECRET_KEY=change-me-32-char-ai-studio-secret
MICROGATEWAY_ENCRYPTION_KEY=change-me-32-char-encryption-key
# Keeps CSRF tokens valid across restarts (random per process when unset)
CSRF_KEY=change-me-32-char-csrf-key-value

# =============================================================================
# Hub-Spoke: Control Plane Mode
# =============================================================================
GATEWAY_MODE=control
GRPC_PORT=50051
GRPC_HOST=0.0.0.0
GRPC_TLS_INSECURE=true
GRPC_AUTH_TOKEN=change-me-grpc-auth-token

# =============================================================================
# Proxy - Point to external Edge Gateway URL
# =============================================================================
PROXY_URL=http://localhost:9091
TOOL_DISPLAY_URL=http://localhost:9091
DATASOURCE_DISPLAY_URL=http://localhost:9091

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info
DEBUG_HTTP=false
DEBUG_HTTP_PROXY=false

# =============================================================================
# Plugins
# =============================================================================
# ./plugins is mounted at /opt/plugins, which is in the default allowed
# plugin directories. Extend with AI_STUDIO_PLUGIN_ALLOWED_DIRS if needed.
PLUGIN_COMMAND_ALLOWLIST=/opt/plugins

# =============================================================================
# Plugin Marketplace (Optional - enables browsing and installing plugins)
# =============================================================================
# AI_STUDIO_OCI_CACHE_DIR must be set to enable the marketplace.
# Without it, the Marketplace page will be empty.
MARKETPLACE_ENABLED=true
MARKETPLACE_INDEX_URL=https://raw.githubusercontent.com/TykTechnologies/tyk-ai-studio-plugins-ce/main/index.yaml
MARKETPLACE_SYNC_INTERVAL=1h
MARKETPLACE_CACHE_DIR=./data/cache/marketplace
AI_STUDIO_OCI_CACHE_DIR=./data/cache/plugins
AI_STUDIO_OCI_REQUIRE_SIGNATURE=false # cosign is not available in distroless images

# =============================================================================
# Metrics (Optional - /metrics is not served unless one of these is set)
# =============================================================================
# METRICS_AUTH_TOKEN=change-me-metrics-token
# METRICS_ALLOW_UNAUTHENTICATED=true

# =============================================================================
# Enterprise Edition
# =============================================================================
# TYK_AI_LICENSE is passed in from .env by docker-compose.yml

# =============================================================================
# SMTP (Optional - required for email invites/notifications)
# =============================================================================
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-password
