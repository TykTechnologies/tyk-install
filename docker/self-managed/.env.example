# DASHBOARD LICENSE Key (REQUIRED)
TYK_LICENSE_KEY=
# DEV PORTAL LICENSE Key (REQUIRED for dev portal)
TYK_PORTAL_LICENSE=

DASHBOARD_VERSION=v5.16.0
GATEWAY_VERSION=v5.16.0
PUMP_VERSION=v1.18.0
PORTAL_VERSION=v1.20.0

# Observability (docker-compose.otel.yml), all optional
# GRAFANA_ADMIN_PASSWORD=admin
# Also send everything to another backend: none, otlp, prometheus-remote-write, datadog, azure-monitor, google-cloud, aws
# OTEL_COLLECTOR_EXPORTER=none
# Variables of the selected backend, see observability/collector/exporters
# OTLP_EXPORT_ENDPOINT=
# OTLP_EXPORT_HEADERS={"Authorization":"Basic <token>"}

# Host ports. Defaults match the previous hardcoded values, so leaving these
# unset changes nothing. Override when something already listens on one.
GATEWAY_PORT=8080
DASHBOARD_PORT=3000
PORTAL_PORT=3001
REDIS_PORT=6379
POSTGRES_PORT=5432
