# =============================================================================
# MDCB CONTROL PLANE
# =============================================================================
# Start this before any data plane. The data planes cannot complete their RPC
# handshake until MDCB is serving on 9091.
# =============================================================================

# DASHBOARD LICENSE Key (REQUIRED)
TYK_LICENSE_KEY=
# MDCB LICENSE Key (REQUIRED - separate from the Dashboard licence)
TYK_MDCB_LICENSE=
# DEV PORTAL LICENSE Key (only if you add the Portal to this stack)
TYK_PORTAL_LICENSE=

DASHBOARD_VERSION=v5.14.0
GATEWAY_VERSION=v5.14.0
PUMP_VERSION=v1.16.0
MDCB_VERSION=v2.12.0

# Host ports
GATEWAY_PORT=8080
DASHBOARD_PORT=3000
MDCB_PORT=9091
REDIS_PORT=6379
POSTGRES_PORT=5432
