# =============================================================================
# MDCB DATA PLANE
# =============================================================================
# Needs no licence of its own - it inherits entitlement from the control plane
# over RPC. It does need three identifiers from the control-plane Dashboard,
# set in confs/tyk.env:
#
#   TYK_GW_SLAVEOPTIONS_RPCKEY    organisation ID
#   TYK_GW_SLAVEOPTIONS_APIKEY    Dashboard user API key
#   TYK_GW_SLAVEOPTIONS_GROUPID   a name you choose for this cluster
#
# All three must be right. One wrong value fails the handshake with
# "RPC Login incorrect" -- which is also what you get if the organisation is not
# hybrid_enabled, or if MDCB is pointed at the wrong database. Check MDCB's own
# log to tell those apart; see ../README.md troubleshooting.
# =============================================================================

# Wiring to the control plane. All four are required; one wrong value fails the
# RPC handshake with "access denied", which looks identical to a licence problem.
# SECURITY: these live here in the gitignored .env, never in confs/tyk.env.
MDCB_CONNECTIONSTRING=host.docker.internal:9091
MDCB_ORG_ID=
MDCB_API_KEY=
MDCB_GROUP_ID=dp-1

GATEWAY_VERSION=v5.16.0
PUMP_VERSION=v1.18.0

# Host ports. Defaulted away from the control plane's so both can run on one host.
GATEWAY_PORT=8081
REDIS_PORT=6380
