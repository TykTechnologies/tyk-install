### =============================================================================
### TYK PUMP ENVIRONMENT CONFIGURATION (OSS)
### =============================================================================
### Optional in OSS. Started only by the `analytics` Compose profile:
###   docker compose --profile analytics up -d
###
### OSS has no Dashboard, so there is no built-in place for analytics to land.
### Pick a sink below that you actually read - the stdout pump is enabled here
### purely so a first run shows something without external infrastructure.
### =============================================================================

### -----------------------------------------------------------------------------
### SOURCE (Redis, shared with the Gateway)
### -----------------------------------------------------------------------------
TYK_PMP_ANALYTICSSTORAGETYPE=redis
TYK_PMP_ANALYTICSSTORAGECONFIG_TYPE=redis
TYK_PMP_ANALYTICSSTORAGECONFIG_ADDRS=tyk-redis:6379 # PROD: Use Redis Cluster e.g. ["server1:6379","server2:6380"]
TYK_PMP_ANALYTICSSTORAGECONFIG_DATABASE=0
TYK_PMP_ANALYTICSSTORAGECONFIG_MAXIDLE=100
TYK_PMP_ANALYTICSSTORAGECONFIG_MAXACTIVE=200
TYK_PMP_ANALYTICSSTORAGECONFIG_ENABLECLUSTER=false # PROD/PERFORMANCE: Set to true for Redis Cluster
TYK_PMP_ANALYTICSSTORAGECONFIG_USESSL=false # PROD: Set to true for secure Redis connections

### -----------------------------------------------------------------------------
### PURGE BEHAVIOUR
### -----------------------------------------------------------------------------
TYK_PMP_PURGEDELAY=10 # Seconds between purges. PROD/PERFORMANCE: Lower for fresher data, higher to reduce Redis load
TYK_PMP_DONTPURGEUPTIMEDATA=true # Set to false only if you have an uptime pump configured

### -----------------------------------------------------------------------------
### SINKS
### -----------------------------------------------------------------------------
### stdout is the only sink that needs no external service. Replace it with a
### real one before this is anything but a demo.
### -----------------------------------------------------------------------------
TYK_PMP_PUMPS_STDOUT_TYPE=stdout
TYK_PMP_PUMPS_STDOUT_META_FORMAT=json
TYK_PMP_PUMPS_STDOUT_META_LOGFIELDNAME=tyk-analytics-record

### Prometheus - scrape http://tyk-pump-oss:9090/metrics
# TYK_PMP_PUMPS_PROMETHEUS_TYPE=prometheus
# TYK_PMP_PUMPS_PROMETHEUS_META_LISTENADDRESS=:9090
# TYK_PMP_PUMPS_PROMETHEUS_META_PATH=/metrics
# TYK_PMP_PUMPS_PROMETHEUS_META_AGGREGATEOBSERVATIONS=true # PROD/PERFORMANCE: Set to true to reduce cardinality and CPU

### Elasticsearch. Tyk Pump supports major versions 3, 5, 6, and 7 only.
# TYK_PMP_PUMPS_ELASTICSEARCH_TYPE=elasticsearch
# TYK_PMP_PUMPS_ELASTICSEARCH_META_INDEXNAME=tyk_analytics
# TYK_PMP_PUMPS_ELASTICSEARCH_META_ELASTICSEARCHURL=http://elasticsearch:9200
# TYK_PMP_PUMPS_ELASTICSEARCH_META_VERSION=7 # PROD: Must be 3, 5, 6, or 7; version 8 is not supported
# TYK_PMP_PUMPS_ELASTICSEARCH_META_ENABLEBULK=true # PROD/PERFORMANCE: Set to true for bulk indexing
